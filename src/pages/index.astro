---
import Layout from '../layouts/Layout.astro';
import bio from '../content/bio.md?raw';
import releases from '../content/releases.json';
---

<Layout title="TiMO ODV">
  <section class="hero">
    <h1>TIMO<br>ODV</h1>
    <div class="subtitle">South African DJ / Producer</div>
    <div class="genre">Melodic House · Indie Dance</div>
    <div class="cta-row">
      <a href="#releases" class="cta">Latest Releases →</a>
    </div>
  </section>

  <section id="releases">
    <h2>Releases</h2>
    <ul style="list-style:none;padding:0">
      {releases.map(r => (
        <li style="padding:1.4rem 0;border-bottom:1px solid #222;display:flex;justify-content:space-between">
          <strong>{r.title}</strong>
          <span>{r.date}</span>
        </li>
      ))}
    </ul>
  </section>

  <section id="story">
    <h2>The Story</h2>
    <div set:html={bio.replace(/\n\n/g, '</p><p>')} />
  </section>

  <section id="booking">
    <h2>Booking</h2>
    <form action="/api/booking" method="POST" style="max-width:26rem;display:flex;flex-direction:column;gap:.8rem">
      <input name="name" required placeholder="Name" style="padding:.9rem;background:#111;border:1px solid #333;color:#fff" />
      <input name="email" type="email" required placeholder="Email" style="padding:.9rem;background:#111;border:1px solid #333;color:#fff" />
      <textarea name="message" required placeholder="Event details" rows="4" style="padding:.9rem;background:#111;border:1px solid #333;color:#fff"></textarea>
      <input name="website" class="honeypot" tabindex="-1" style="position:absolute;left:-9999px" />
      <button class="cta" type="submit">Send enquiry</button>
    </form>
  </section>
</Layout>
