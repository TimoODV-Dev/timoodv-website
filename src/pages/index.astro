---
import Layout from '../layouts/Layout.astro';
import bio from '../content/bio.md?raw';
import site from '../content/site.json';
import releases from '../content/releases.json';

const featured = site.featuredVideoId;
---

<Layout title="TiMO ODV — Melodic House & Indie Dance">
  <section class="hero">
    <h1>TiMO<br>ODV</h1>
    <p>Melodic House & Indie Dance</p>
    {featured && (
      <div class="video-facade" data-id={featured}>
        <button>Play latest clip</button>
      </div>
    )}
  </section>

  <section class="releases" id="releases">
    <h2>Latest Releases</h2>
    <ul>
      {releases.map((r) => (
        <li>
          <strong>{r.title}</strong>
          <span>{r.date}{r.youtubeId ? ' · YouTube' : ''}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="story" id="story">
    <h2>The Story</h2>
    <div set:html={bio.replace(/\n\n/g, '</p><p>').replace(/\n/g, '<br>')} />
  </section>

  <section class="booking" id="booking">
    <h2>Booking</h2>
    <form action="/api/booking" method="POST">
      <input type="text" name="name" required maxlength="100" placeholder="Your name" />
      <input type="email" name="email" required maxlength="200" placeholder="Email" />
      <textarea name="message" required maxlength="1000" placeholder="Tell us about the event" rows="5"></textarea>
      <input type="text" name="website" class="honeypot" tabindex="-1" autocomplete="off" />
      <button type="submit">Send enquiry</button>
    </form>
    <p style="margin-top:1.5rem;color:var(--muted)">Or email <a href={`mailto:${site.bookingEmail}`}>{site.bookingEmail}</a></p>
  </section>
</Layout>

<script>
  document.querySelectorAll('.video-facade').forEach((el) => {
    el.addEventListener('click', () => {
      const id = el.dataset.id;
      el.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1" style="width:100%;height:100%;border:0" allow="autoplay; encrypted-media" allowfullscreen></iframe>`;
    });
  });
</script>
