---
import Layout from '../layouts/Layout.astro';
import bio from '../content/bio.md?raw';
import releases from '../content/releases.json';
---

<Layout title="TiMO ODV">
  <section class="hero">
    <h1>TIMO<br>ODV</h1>
    <div class="subtitle">South African DJ / Producer</div>
    <div class="genre">Melodic House · Indie Dance</div>
    <a href="#releases" class="cta">Latest Releases</a>
  </section>

  <section class="releases" id="releases">
    <h2>Releases</h2>
    <ul>
      {releases.map(r => (
        <li>
          <strong>{r.title}</strong>
          <span>{r.date}</span>
        </li>
      ))}
    </ul>
  </section>

  <section id="story">
    <h2>The Story</h2>
    <div set:html={bio.replace(/\n\n/g, '</p><p>')} />
  </section>

  <section id="booking">
    <h2>Booking</h2>
    <form action="/api/booking" method="POST" style="max-width:26rem;display:flex;flex-direction:column;gap:0.75rem">
      <input name="name" required placeholder="Name" style="padding:0.9rem;background:#111;border:1px solid #333;color:#fff;font:inherit" />
      <input name="email" type="email" required placeholder="Email" style="padding:0.9rem;background:#111;border:1px solid #333;color:#fff;font:inherit" />
      <textarea name="message" required placeholder="Event details" rows="4" style="padding:0.9rem;background:#111;border:1px solid #333;color:#fff;font:inherit"></textarea>
      <input name="website" class="honeypot" tabindex="-1" style="position:absolute;left:-9999px" />
      <button type="submit" class="cta" style="align-self:flex-start;cursor:pointer">Send enquiry</button>
    </form>
  </section>
</Layout>
