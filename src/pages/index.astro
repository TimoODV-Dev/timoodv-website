---
import Layout from '../layouts/Layout.astro';
import bio from '../content/bio.md?raw';
import site from '../content/site.json';
import releases from '../content/releases.json';
---

<Layout title="TiMO ODV">
  <section class="hero">
    <h1>TIMO<br>ODV</h1>
    <div class="tag">Melodic House · Indie Dance</div>
    <a href="#releases" class="cta">Latest Releases</a>
  </section>

  <section class="releases" id="releases">
    <h2>Releases</h2>
    <ul>
      {releases.map((r) => (
        <li>
          <strong>{r.title}</strong>
          <span>{r.date}</span>
        </li>
      ))}
    </ul>
  </section>

  <section id="story">
    <h2>The Story</h2>
    <div set:html={bio.replace(/\n\n/g, '</p><p>')} />
  </section>

  <section id="booking">
    <h2>Booking</h2>
    <form action="/api/booking" method="POST">
      <input type="text" name="name" required placeholder="Name" />
      <input type="email" name="email" required placeholder="Email" />
      <textarea name="message" required placeholder="Event details" rows="4"></textarea>
      <input type="text" name="website" class="honeypot" tabindex="-1" />
      <button type="submit" class="cta">Send enquiry</button>
    </form>
  </section>
</Layout>
